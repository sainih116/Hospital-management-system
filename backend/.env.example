# Copy this file to .env for local development. Never commit a real .env file.

APP_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=hms
MONGO_CONNECT_TIMEOUT_SECONDS=10

# Redis (optional cache layer)
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (required in production)
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080
JWT_ISSUER=hms-backend

SHUTDOWN_TIMEOUT_SECONDS=15

# cmd/seed — initial admin + sample data bootstrap (idempotent; safe to leave set)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DOCTOR_PASSWORD=ChangeMe123!
